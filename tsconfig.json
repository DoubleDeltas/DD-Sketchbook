{
  "compilerOptions": {
    "types": ["fvtt-types"],
    "target": "esnext",
    "module": "ESNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "alwaysStrict": true,
    "removeComments": true
  },
  "include": ["src/**/*"]
}
